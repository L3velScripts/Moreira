    titleLabel.BackgroundTransparency = 1

    local dragging, dragInput, dragStart, startPos
    local function updateInput(input)
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            updateInput(input)
        end
    end)

    local contentFrame = Instance.new("Frame", mainFrame)
    contentFrame.Size = UDim2.new(1, -24, 1, -48)
    contentFrame.Position = UDim2.new(0, 12, 0, 44)
    contentFrame.BackgroundTransparency = 1

    local autoGrabBtn = Instance.new("TextButton", contentFrame)
    autoGrabBtn.Size = UDim2.new(1, 0, 0, 38)
    autoGrabBtn.Position = UDim2.new(0, 0, 0, 0)
    autoGrabBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 80)
    autoGrabBtn.Text = "AUTO GRAB: ON"
    autoGrabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    autoGrabBtn.Font = Enum.Font.GothamBold
    autoGrabBtn.TextSize = 13
    Instance.new("UICorner", autoGrabBtn).CornerRadius = UDim.new(0, 8)

    autoGrabBtn.MouseButton1Click:Connect(function()
        M.Steal.AutoStealEnabled = not M.Steal.AutoStealEnabled
        if M.Steal.AutoStealEnabled then
            autoGrabBtn.Text = "AUTO GRAB: ON"
            autoGrabBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 80)
            M.startSemiSteal()
        else
            autoGrabBtn.Text = "AUTO GRAB: OFF"
            autoGrabBtn.BackgroundColor3 = Color3.fromRGB(120, 35, 35)
            M.stopSemiSteal()
        end
    end)

    local discordBtn = Instance.new("TextButton", contentFrame)
    discordBtn.Size = UDim2.new(1, 0, 0, 38)
    discordBtn.Position = UDim2.new(0, 0, 0, 46)
    discordBtn.BackgroundColor3 = Color3.fromRGB(40, 55, 120)
    discordBtn.Text = "COPY DISCORD"
    discordBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    discordBtn.Font = Enum.Font.GothamBold
    discordBtn.TextSize = 13
    Instance.new("UICorner", discordBtn).CornerRadius = UDim.new(0, 8)

    discordBtn.MouseButton1Click:Connect(function()
        local discordUrl = "https://discord.gg/hRx2nfw3Hc"
        if setclipboard then
            setclipboard(discordUrl)
        elseif toclipboard then
            toclipboard(discordUrl)
        end
        discordBtn.Text = "COPIED TO CLIPBOARD!"
        discordBtn.BackgroundColor3 = Color3.fromRGB(30, 110, 70)
        task.delay(2, function()
            discordBtn.Text = "COPY DISCORD"
            discordBtn.BackgroundColor3 = Color3.fromRGB(40, 55, 120)
        end)
    end)

    statusLabel = Instance.new("TextLabel", contentFrame)
    statusLabel.Size = UDim2.new(1, 0, 0, 38)
    statusLabel.Position = UDim2.new(0, 0, 0, 92)
    statusLabel.BackgroundColor3 = Color3.fromRGB(20, 28, 50)
    statusLabel.TextColor3 = Color3.fromRGB(72, 202, 228)
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 12
    statusLabel.Text = "READY"
    Instance.new("UICorner", statusLabel).CornerRadius = UDim.new(0, 8)

    local readyStroke = Instance.new("UIStroke", statusLabel)
    readyStroke.Color = Color3.fromRGB(35, 55, 90)
    readyStroke.Thickness = 1

    M.startSemiSteal()
end)

