-- ========================================================
-- OPTIMIZACIÓN ANTI LAG (DIRECTO SIN MENÚ)
-- ========================================================
task.spawn(function()
    local Players = game:GetService("Players")
    local Lighting = game:GetService("Lighting")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer

    local function DeepOptimize(obj)
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            obj.CastShadow = false
            pcall(function()
                obj.Material = Enum.Material.Plastic
                if obj:IsA("MeshPart") then
                    obj.RenderFidelity = Enum.RenderFidelity.Performance
                end
            end)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj.Enabled = false
            pcall(function() obj:Destroy() end)
        elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            obj.Enabled = false
            pcall(function() obj:Destroy() end)
        end
    end

    local function FullCleanup()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9
        for _, v in ipairs(Lighting:GetDescendants()) do
            if v:IsA("PostEffect") then v.Enabled = false end
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

        for _, obj in ipairs(Workspace:GetDescendants()) do
            DeepOptimize(obj)
        end
    end

    local function OptimizeCharacter(char)
        if not char then return end
        for _, obj in ipairs(char:GetDescendants()) do
            DeepOptimize(obj)
        end
    end

    local DescConn = Workspace.DescendantAdded:Connect(function(obj)
        task.defer(DeepOptimize, obj)
    end)

    LocalPlayer.CharacterAdded:Connect(OptimizeCharacter)
    if LocalPlayer.Character then OptimizeCharacter(LocalPlayer.Character) end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            OptimizeCharacter(plr.Character)
        end
    end

    FullCleanup()

    task.delay(1.5, function()
        if DescConn then
            DescConn:Disconnect()
            DescConn = nil
        end
    end)
end)

-- ========================================================
-- FUNCIONALIDAD ESP BASE (CON TOGGLE ON/OFF POR BOTÓN)
-- ========================================================
local baseEspActive = false
local originalStates = {}

local function toggleBaseESP()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then return end

    baseEspActive = not baseEspActive
    local GHOST_TRANSPARENCY = 0.7
    local GHOST_COLOR = Color3.fromRGB(0, 255, 255)

    local function processObject(obj)
        if baseEspActive then
            if not originalStates[obj] then
                if obj:IsA("BasePart") then
                    originalStates[obj] = {
                        Transparency = obj.Transparency,
                        Color = obj.Color,
                        LocalTransparencyModifier = obj.LocalTransparencyModifier,
                        CanCollide = obj.CanCollide
                    }
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    originalStates[obj] = { Transparency = obj.Transparency }
                elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                    originalStates[obj] = { Enabled = obj.Enabled }
                end
            end

            if obj:IsA("BasePart") then
                obj.Transparency = GHOST_TRANSPARENCY
                obj.Color = GHOST_COLOR
                obj.LocalTransparencyModifier = GHOST_TRANSPARENCY
                obj.CanCollide = true
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = GHOST_TRANSPARENCY
            elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                obj.Enabled = false
            end
        else
            if originalStates[obj] then
                local st = originalStates[obj]
                if obj:IsA("BasePart") then
                    obj.Transparency = st.Transparency
                    obj.Color = st.Color
                    obj.LocalTransparencyModifier = st.LocalTransparencyModifier
                    obj.CanCollide = st.CanCollide
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = st.Transparency
                elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                    obj.Enabled = st.Enabled
                end
            end
        end
    end

    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local decorations = plot:FindFirstChild("Decorations")
        if decorations then
            for _, obj in ipairs(decorations:GetDescendants()) do
                processObject(obj)
            end
        end
    end

    if not baseEspActive then
        originalStates = {}
    end
end

-- ========================================================
-- AUTO STEAL CON MENÚ, BARRA, DISTANCIA Y PISO (KIRA MOREIRA)
-- ========================================================
task.spawn(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UIS = game:GetService("UserInputService")
    local Stats = game:GetService("Stats")
    local LP = Players.LocalPlayer
    local pg = LP:WaitForChild("PlayerGui")

    local getconnections = getconnections or (getgenv and getgenv().getconnections)

    local SEARCH_RADIUS = 75
    local ACTIVE_RADIUS = 100

    local Steal = {
        AutoStealEnabled = true,
        StealRadius = SEARCH_RADIUS,
        StealDuration = 1.3,
        Mode = 4,
        Data = {},
    }
    local STEAL_MODE_CFG = {
        [1] = { threshold = 0.90, nearDist = 14 },
        [2] = { threshold = 0.85, nearDist = 12 },
        [3] = { threshold = 0.80, nearDist = 11 },
        [4] = { threshold = 0.75, nearDist = 10 },
    }
    local isStealing = false
    local currentStealPrompt = nil
    local stealConn = nil
    local progressFill, statusLbl, main, title

    local function getStealHRP()
        local c = LP.Character
        return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
    end

    local function getFloorLevel()
        local hrp = getStealHRP()
        if not hrp then return "Piso: N/A" end
        local y = hrp.Position.Y
        if y < 20 then return "Piso 1"
        elseif y >= 20 and y < 40 then return "Piso 2"
        elseif y >= 40 and y < 60 then return "Piso 3"
        else return string.format("Piso %d", math.floor(y / 20) + 1) end
    end

    local function isMyPlotByName(plotName)
        local plots = workspace:FindFirstChild("Plots")
        local plot = plots and plots:FindFirstChild(plotName)
        if not plot then return false end
        local sign = plot:FindFirstChild("PlotSign")
        local yb = sign and sign:FindFirstChild("YourBase")
        return yb and yb:IsA("BillboardGui") and yb.Enabled
    end

    local function getPromptPosition(prompt)
        if not prompt then return nil end
        local p = prompt.Parent
        while p and p ~= workspace do
            if p:IsA("BasePart") then return p.Position end
            p = p.Parent
        end
        return nil
    end

    local function findNearestPrompt()
        local hrp = getStealHRP()
        if not hrp then return nil, math.huge end
        local plots = workspace:FindFirstChild("Plots")
        if not plots then return nil, math.huge end
        local nearest, dist = nil, math.huge
        local currentMaxRadius = isStealing and ACTIVE_RADIUS or SEARCH_RADIUS

        for _, plot in ipairs(plots:GetChildren()) do
            if isMyPlotByName(plot.Name) then continue end
            local pods = plot:FindFirstChild("AnimalPodiums")
            if not pods then continue end
            for _, pod in ipairs(pods:GetChildren()) do
                local base = pod:FindFirstChild("Base")
                if not base then continue end
                local spawn = base:FindFirstChild("Spawn")
                if not spawn then continue end
                local d = (spawn.Position - hrp.Position).Magnitude
                if d <= currentMaxRadius and d < dist then
                    local att = spawn:FindFirstChild("PromptAttachment")
                    if att then
                        for _, p in ipairs(att:GetChildren()) do
                            if p:IsA("ProximityPrompt") and p.ActionText and p.ActionText:find("Steal") then
                                nearest, dist = p, d
                            end
                        end
                    end
                end
            end
        end
        return nearest, dist
    end

    local function setBar(p)
        p = math.clamp(p or 0, 0, 1)
        if progressFill then progressFill.Size = UDim2.new(p, 0, 1, 0) end
        local pct = math.floor(p * 100)
        if title then title.Text = string.format("KIRA MOREIRA <font color=\"#2D88FF\">%d%%</font>", pct) end
    end

    local function executeSteal(prompt)
        if isStealing or not Steal.AutoStealEnabled then return end
        if not Steal.Data[prompt] then
            Steal.Data[prompt] = { hold = {}, trigger = {}, ready = true }
            if getconnections then
                for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan) or {}) do
                    if c.Function then table.insert(Steal.Data[prompt].hold, c.Function) end
                end
                for _, c in ipairs(getconnections(prompt.Triggered) or {}) do
                    if c.Function then table.insert(Steal.Data[prompt].trigger, c.Function) end
                end
            end
        end
        local data = Steal.Data[prompt]
        if not data.ready then return end
        data.ready = false
        autoStealBusy = true
        isStealing = true
        currentStealPrompt = prompt

        task.spawn(function()
            for _, f in ipairs(data.hold) do pcall(f) end
        end)
        local cfg = STEAL_MODE_CFG[Steal.Mode] or STEAL_MODE_CFG[4]
        local threshold = cfg.threshold
        local totalTime = tonumber(Steal.StealDuration) or 1.3
        local timeToThreshold = totalTime * threshold
        local timeAfterThreshold = totalTime - timeToThreshold
        local startTime = tick()

        while tick() - startTime < timeToThreshold do
            local hrp = getStealHRP()
            local targetPos = getPromptPosition(prompt)
            if not Steal.AutoStealEnabled or not hrp or not targetPos or (targetPos - hrp.Position).Magnitude > ACTIVE_RADIUS then
                isStealing = false; currentStealPrompt = nil; data.ready = true; autoStealBusy = false; return
            end
            setBar(math.clamp((tick() - startTime) / totalTime, 0, threshold))
            task.wait()
        end
        setBar(threshold)

        local resumeTime = tick()
        while tick() - resumeTime < timeAfterThreshold do
            local hrp = getStealHRP()
            local targetPos = getPromptPosition(prompt)
            if not Steal.AutoStealEnabled or not hrp or not targetPos or (targetPos - hrp.Position).Magnitude > ACTIVE_RADIUS then
                isStealing = false; currentStealPrompt = nil; data.ready = true; autoStealBusy = false; return
            end
            local fin = (tick() - resumeTime) / math.max(timeAfterThreshold, 0.01)
            setBar(threshold + fin * (1 - threshold))
            task.wait()
        end
        setBar(1)

        for _, f in ipairs(data.trigger) do pcall(f) end
        task.wait(0.05)
        data.ready = true
        isStealing = false
        currentStealPrompt = nil
        autoStealBusy = false
        setBar(0)
    end

    local function startAutoSteal()
        if stealConn then return end
        stealConn = RunService.Heartbeat:Connect(function()
            if isStealing or not Steal.AutoStealEnabled then return end
            local ok, prompt = pcall(findNearestPrompt)
            if ok and prompt then
                pcall(executeSteal, prompt)
            end
        end)
    end

    pcall(function()
        local old = pg:FindFirstChild("MiroAutoStealUI")
        if old then old:Destroy() end
    end)

    local gui = Instance.new("ScreenGui")
    gui.Name = "MiroAutoStealUI"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 200
    gui.Enabled = false -- UI oculta; la lógica de AutoSteal sigue activa
    gui.Parent = pg

    main = Instance.new("Frame")
    main.Name = "StealProgressGui"
    main.Active = false
    main.AnchorPoint = Vector2.new(0.5, 1)
    main.Position = UDim2.new(0.5, 0, 1, -100)
    main.Size = UDim2.new(0, 340, 0, 58)
    main.BackgroundColor3 = Color3.fromRGB(10, 18, 32)
    main.BorderSizePixel = 0
    main.Parent = gui
    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)

    local centerContainer = Instance.new("Frame", main)
    centerContainer.BackgroundTransparency = 1
    centerContainer.Size = UDim2.new(1, 0, 0, 18)
    centerContainer.Position = UDim2.new(0, 0, 0, 6)

    title = Instance.new("TextLabel", centerContainer)
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 1, 0)
    title.Text = "KIRA MOREIRA <font color=\"#2D88FF\">0%</font>"
    title.RichText = true
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 13
    title.Font = Enum.Font.GothamBlack
    title.TextXAlignment = Enum.TextXAlignment.Center

    local barBg = Instance.new("Frame", main)
    barBg.Position = UDim2.new(0, 12, 0, 28)
    barBg.Size = UDim2.new(1, -24, 0, 10)
    barBg.BackgroundColor3 = Color3.fromRGB(20, 30, 48)
    barBg.BorderSizePixel = 0
    barBg.ClipsDescendants = true
    barBg.ZIndex = 3
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    progressFill = Instance.new("Frame", barBg)
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    progressFill.BackgroundColor3 = Color3.fromRGB(45, 136, 255)
    progressFill.BorderSizePixel = 0
    progressFill.ZIndex = 4
    Instance.new("UICorner", progressFill).CornerRadius = UDim.new(1, 0)

    statusLbl = Instance.new("TextLabel", main)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Position = UDim2.new(0, 12, 0, 40)
    statusLbl.Size = UDim2.new(1, -24, 0, 14)
    statusLbl.Text = "Dist: --m | Piso: -- | Ping: -- | FPS: --"
    statusLbl.TextColor3 = Color3.fromRGB(150, 170, 200)
    statusLbl.Font = Enum.Font.Gotham
    statusLbl.TextSize = 11
    statusLbl.ZIndex = 3

    startAutoSteal()

    task.spawn(function()
        local fps = 0
        RunService.RenderStepped:Connect(function() fps += 1 end)
        while main.Parent do
            task.wait(1)
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            local currentDist = math.huge
            local hrp = getStealHRP()
            if isStealing and currentStealPrompt and hrp then
                local tp = getPromptPosition(currentStealPrompt)
                if tp then currentDist = (tp - hrp.Position).Magnitude end
            else
                _, currentDist = findNearestPrompt()
            end
            local distText = (currentDist and currentDist ~= math.huge) and string.format("%.1fm", currentDist) or "--m"
            local floorText = getFloorLevel()
            statusLbl.Text = string.format("Dist: %s | %s | Ping: %dms | FPS: %d", distText, floorText, ping, fps)
            fps = 0
        end
    end)
end)

